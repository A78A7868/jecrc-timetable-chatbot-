{
  "id": "3",
  "name": "JECRC WhatsApp - Messages",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wa-msg-trigger",
      "name": "WhatsApp Messages Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [256, 304],
      "webhookId": "b2c3d4e5-f6a7-8901-bcde-f12345678901"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "OK",
        "options": { "responseCode": 200 }
      },
      "id": "ack-response",
      "name": "Acknowledge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [480, 208]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst entry = body?.entry?.[0];\nconst change = entry?.changes?.[0]?.value;\nconst message = change?.messages?.[0];\nconst contact = change?.contacts?.[0];\n\nif (!message) return [{ json: { skip: true } }];\n\nconst base = {\n  skip: false,\n  isUnsupported: false,\n  phoneNumber: message.from,\n  phoneNumberId: change.metadata.phone_number_id,\n  contactName: contact?.profile?.name || 'Student',\n  timestamp: message.timestamp,\n};\n\nif (message.type !== 'text' && message.type !== 'interactive') {\n  return [{ json: { ...base, isUnsupported: true, response: 'I only understand text messages.' } }];\n}\n\nconst query = message.type === 'text' ? message.text.body : (message.interactive?.list_reply?.title || message.interactive?.button_reply?.title || '');\n\nreturn [{ json: { ...base, query } }];"
      },
      "id": "extract-message",
      "name": "Extract Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 400]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            { "leftValue": "={{ $json.skip }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }
          ]
        }
      },
      "id": "skip-check",
      "name": "Should Skip?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 400]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            { "leftValue": "={{ $json.isUnsupported }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }
          ]
        }
      },
      "id": "unsupported-check",
      "name": "Unsupported Type?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [920, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v18.0/{{ $json.phoneNumberId }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.WHATSAPP_API_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { messaging_product: 'whatsapp', recipient_type: 'individual', to: $json.phoneNumber, type: 'text', text: { preview_url: false, body: $json.response } } }}",
        "options": {}
      },
      "id": "send-reply",
      "name": "Send WhatsApp Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 400]
    }
  ],
  "connections": {
    "WhatsApp Messages Webhook": {
      "main": [
        [{ "node": "Acknowledge", "type": "main", "index": 0 }],
        [{ "node": "Extract Message", "type": "main", "index": 0 }]
      ]
    },
    "Extract Message": {
      "main": [[{ "node": "Should Skip?", "type": "main", "index": 0 }]]
    },
    "Should Skip?": {
      "main": [
        [],
        [{ "node": "Unsupported Type?", "type": "main", "index": 0 }]
      ]
    },
    "Unsupported Type?": {
      "main": [
        [{ "node": "Send WhatsApp Reply", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "instanceId": "jecrc-timetable-chatbot" }
}
